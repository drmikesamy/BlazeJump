@page "/import-keys"
@using BlazeJump.Common.Enums;
@using BlazeJump.Common.Models;
@using BlazeJump.Common.Models.Crypto;
@using BlazeJump.Common.Pages.Components
@using BlazeJump.Common.Services.Crypto;
@using BlazeJump.Common.Services.Notification;
@using BlazeJump.Common.Services.UserProfile;
@using BlazeJump.Common.Helpers;
@inject ICryptoService CryptoService
@inject IUserProfileService UserProfileService
@inject INotificationService NotificationService
@inject NavigationManager NavigationManager

<div class="background-container">
    <div class="content-container">
        <Card>
            <div class="import-keys-container">
                <h1>🔑 Import Your Nostr Keys</h1>
                <p>Import your existing Nostr private key to access your account</p>
                
                <div class="import-form">
                    <div class="import-method-tabs">
                        <button type="button" 
                                class="tab-button @(_importMethod == ImportMethod.PrivateKey ? "active" : "")" 
                                @onclick="() => _importMethod = ImportMethod.PrivateKey">
                            Private Key
                        </button>
                        <button type="button" 
                                class="tab-button @(_importMethod == ImportMethod.Mnemonic ? "active" : "")" 
                                @onclick="() => _importMethod = ImportMethod.Mnemonic">
                            Seed Phrase
                        </button>
                    </div>
                    
                    <div class="import-content">
                        @if (_importMethod == ImportMethod.PrivateKey)
                        {
                            <div class="import-section">
                                <h3>Import Private Key</h3>
                                <p>Enter your Nostr private key (nsec format or hex)</p>
                                
                                <div class="input-group">
                                    <label for="private-key">Private Key:</label>
                                    <textarea id="private-key" 
                                             @bind="_privateKeyInput" 
                                             placeholder="nsec1... or hex private key"
                                             class="key-input"
                                             rows="3"></textarea>
                                    <small class="input-hint">
                                        Starts with 'nsec1' (bech32) or 64 hex characters
                                    </small>
                                </div>
                                
                                @if (!string.IsNullOrEmpty(_validationError))
                                {
                                    <div class="error-message">
                                        <span class="error-icon">❌</span>
                                        @_validationError
                                    </div>
                                }
                                
                                @if (_derivedPublicKey != null)
                                {
                                    <div class="derived-info">
                                        <h4>Derived Public Key:</h4>
                                        <div class="key-display">
                                            <input type="text" readonly value="@_derivedPublicKey" class="readonly-input" />
                                            <button type="button" @onclick="() => CopyToClipboard(_derivedPublicKey)" class="copy-btn">📋</button>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="import-section">
                                <h3>Import Seed Phrase</h3>
                                <p>Enter your 12 or 24 word seed phrase</p>
                                
                                <div class="input-group">
                                    <label for="seed-phrase">Seed Phrase:</label>
                                    <textarea id="seed-phrase" 
                                             @bind="_seedPhraseInput" 
                                             placeholder="word1 word2 word3 ..."
                                             class="key-input"
                                             rows="4"></textarea>
                                    <small class="input-hint">
                                        Enter 12 or 24 words separated by spaces
                                    </small>
                                </div>
                                
                                <div class="mnemonic-warning">
                                    <p><strong>Note:</strong> Seed phrase import is experimental. Most Nostr clients use private keys directly.</p>
                                </div>
                            </div>
                        }
                        
                        <div class="import-actions">
                            <button type="button" 
                                    @onclick="ValidateAndImport" 
                                    class="primary-btn"
                                    disabled="@(_importing || string.IsNullOrWhiteSpace(_privateKeyInput))">
                                @(_importing ? "Importing..." : "Import Keys")
                            </button>
                            
                            <button type="button" @onclick="GoToOnboarding" class="secondary-btn">Back</button>
                        </div>
                        
                        @if (_importing)
                        {
                            <div class="loading-container">
                                <div class="spinner"></div>
                                <p>Importing your keys...</p>
                            </div>
                        }
                        
                        @if (_importSuccess)
                        {
                            <div class="success-container">
                                <div class="success-icon">✅</div>
                                <h3>Keys Imported Successfully!</h3>
                                <p>Your Nostr identity has been restored.</p>
                                
                                <div class="imported-info">
                                    <p><strong>Public Key:</strong> @_importedPublicKey</p>
                                </div>
                                
                                <button type="button" @onclick="GoToHome" class="primary-btn">Continue to Feed</button>
                            </div>
                        }
                    </div>
                </div>
                
                <div class="security-notice">
                    <h3>🔒 Security Notice</h3>
                    <ul>
                        <li>Never share your private key with anyone</li>
                        <li>Make sure you're on the correct website</li>
                        <li>Your keys are processed locally and not sent to any server</li>
                        <li>Consider using a hardware wallet for maximum security</li>
                    </ul>
                </div>
                
                <div class="help-section">
                    <h3>❓ Need Help?</h3>
                    <div class="help-content">
                        <div class="help-item">
                            <strong>Where do I find my private key?</strong>
                            <p>Check your current Nostr client's settings or backup files. It usually starts with 'nsec1'.</p>
                        </div>
                        
                        <div class="help-item">
                            <strong>I don't have a private key yet</strong>
                            <p>You can <a href="/create-account">create a new account</a> to generate fresh keys.</p>
                        </div>
                        
                        <div class="help-item">
                            <strong>Is this secure?</strong>
                            <p>Yes, all key processing happens in your browser. Your private key never leaves your device.</p>
                        </div>
                    </div>
                </div>
            </div>
        </Card>
    </div>
</div>

@code {
    private enum ImportMethod
    {
        PrivateKey,
        Mnemonic
    }
    
    private ImportMethod _importMethod = ImportMethod.PrivateKey;
    private string _privateKeyInput = string.Empty;
    private string _seedPhraseInput = string.Empty;
    private string? _validationError;
    private string? _derivedPublicKey;
    private bool _importing = false;
    private bool _importSuccess = false;
    private string? _importedPublicKey;

    private async Task ValidateAndImport()
    {
        _validationError = null;
        _importing = true;
        StateHasChanged();

        try
        {
            await Task.Delay(500); // Small delay for UX

            if (_importMethod == ImportMethod.PrivateKey)
            {
                await ImportPrivateKey();
            }
            else
            {
                await ImportSeedPhrase();
            }
        }
        catch (Exception ex)
        {
            _validationError = ex.Message;
        }
        finally
        {
            _importing = false;
            StateHasChanged();
        }
    }

    private async Task ImportPrivateKey()
    {
        var input = _privateKeyInput.Trim();
        
        if (string.IsNullOrEmpty(input))
        {
            throw new Exception("Private key cannot be empty");
        }

        byte[] privateKeyBytes;

        try
        {
            if (input.StartsWith("nsec1"))
            {
                // Bech32 format
                var hex = GeneralHelpers.Bech32ToHex(input, Bech32PrefixEnum.nsec);
                privateKeyBytes = Convert.FromHexString(hex);
            }
            else if (input.Length == 64 && IsHex(input))
            {
                // Hex format
                privateKeyBytes = Convert.FromHexString(input);
            }
            else
            {
                throw new Exception("Invalid private key format. Expected nsec1... or 64-character hex string");
            }

            // Validate key length
            if (privateKeyBytes.Length != 32)
            {
                throw new Exception("Private key must be 32 bytes");
            }

            // Create key pair and derive public key
            var privateKey = NBitcoin.Secp256k1.ECPrivKey.Create(privateKeyBytes);
            var publicKey = privateKey.CreatePubKey();
            var publicKeyBytes = publicKey.ToXOnlyPubKey().ToBytes();
            
            // Convert to bech32
            _derivedPublicKey = GeneralHelpers.HexToBech32(Convert.ToHexString(publicKeyBytes), Bech32PrefixEnum.npub);
            
            // Store in crypto service (this would need to be implemented properly)
            // For now, we'll just mark as successful
            _importedPublicKey = _derivedPublicKey;
            
            // Update user profile service
            UserProfileService.NPubKey = _derivedPublicKey;
            UserProfileService.IsLoggedIn = true;
            
            _importSuccess = true;
            // Keys imported successfully
        }
        catch (Exception ex)
        {
            throw new Exception($"Failed to import private key: {ex.Message}");
        }
    }

    private async Task ImportSeedPhrase()
    {
        var words = _seedPhraseInput.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        
        if (words.Length != 12 && words.Length != 24)
        {
            throw new Exception("Seed phrase must be 12 or 24 words");
        }

        // Note: This is a simplified implementation
        // In a real implementation, you'd use BIP39 to derive the private key from the mnemonic
        throw new Exception("Seed phrase import is not yet implemented. Please use private key import instead.");
    }

    private void OnPrivateKeyInput()
    {
        _validationError = null;
        _derivedPublicKey = null;
        
        var input = _privateKeyInput.Trim();
        if (string.IsNullOrEmpty(input)) return;

        try
        {
            byte[] privateKeyBytes;
            
            if (input.StartsWith("nsec1"))
            {
                var hex = GeneralHelpers.Bech32ToHex(input, Bech32PrefixEnum.nsec);
                privateKeyBytes = Convert.FromHexString(hex);
            }
            else if (input.Length == 64 && IsHex(input))
            {
                privateKeyBytes = Convert.FromHexString(input);
            }
            else
            {
                return; // Don't show error while typing
            }

            if (privateKeyBytes.Length == 32)
            {
                var privateKey = NBitcoin.Secp256k1.ECPrivKey.Create(privateKeyBytes);
                var publicKey = privateKey.CreatePubKey();
                var publicKeyBytes = publicKey.ToXOnlyPubKey().ToBytes();
                _derivedPublicKey = GeneralHelpers.HexToBech32(Convert.ToHexString(publicKeyBytes), Bech32PrefixEnum.npub);
            }
        }
        catch
        {
            // Ignore errors while typing
        }
    }

    private bool IsHex(string input)
    {
        return input.All(c => "0123456789abcdefABCDEF".Contains(c));
    }

    private async Task CopyToClipboard(string text)
    {
        // Copied to clipboard functionality would be implemented via JS interop
    }

    private void GoToOnboarding()
    {
        NavigationManager.NavigateTo("/onboarding");
    }

    private void GoToHome()
    {
        NavigationManager.NavigateTo("/");
    }
}
